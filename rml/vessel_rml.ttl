@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ad:  <https://github.com/HaoranGUO430/adrift#> .

<#Vessel> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "{vessels}"
    ] ;

    rr:subjectMap [
        rr:template "https://github.com/HaoranGUO430/adrift#v{mmsi}" ;
        rr:class ad:Vessel
    ] ;
    
    rr:predicateObjectMap [
        rr:predicate ad:mmsi ;
        rr:objectMap [ rml:reference "mmsi" ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ad:name ;
        rr:objectMap [ rml:reference "name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ad:registeredClass ;
        rr:objectMap [ rml:reference "vessel_class" ]
    ] .